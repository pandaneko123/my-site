---
import type { Post } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p>まだ記事がありません。</p>}
<ul>
	{
		posts.map((post) => (
			<li>
				<p class="date">
					<FormattedDate date={post.data.pubDate} />
					{post.data.draft && <span class="draft">下書き</span>}
				</p>
				<a class="title" href={`/blog/${post.id}/`}>
					{post.data.title}
				</a>
				<p class="description">{post.data.description}</p>
				<TagList tags={post.data.tags} />
			</li>
		))
	}
</ul>
<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		padding: 1.2em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	p {
		margin: 0;
	}
	.date {
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.title {
		font-size: 1.25em;
		font-weight: 700;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.title:hover {
		color: var(--accent);
	}
	.description {
		margin: 0.3em 0 0.5em;
		color: rgb(var(--gray-dark));
	}
	.draft {
		margin-left: 0.5em;
		padding: 0 0.5em;
		font-size: 0.85em;
		color: white;
		background: rgb(var(--gray));
		border-radius: 4px;
	}
</style>
